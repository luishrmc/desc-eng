{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "Artigo Academico Federico Faggin e Intel 4004",
  "version": "2.0.0",
  "topology": "Supervisor-Worker Hierarquico Dual-Loop com Barreira de Sincronizacao",
  "governance": {
    "max_iterations_per_section": 5,
    "max_subagent_reuse_rounds": 3,
    "stagnation_threshold": 2,
    "rollback_action": "git checkout HEAD -- {target_file}",
    "require_single_column_figures": true
  },
  "agents": [
    {
      "name": "orchestrator-agent",
      "definition": ".agents/agents/orchestrator-agent.md",
      "role": "Supervisor central de fluxo, DAG, Git e reciclagem de subagentes",
      "model": "pro",
      "permissions": {
        "read": [
          "00_config.tex",
          "main.tex",
          "secoes/*.tex",
          "utils/tema.md",
          "utils/memory/**"
        ],
        "write": [
          "utils/memory/episodes/*.md"
        ]
      },
      "tools_allowed": [
        "read_file",
        "write_file",
        "run_command",
        "send_message",
        "invoke_subagent",
        "define_subagent",
        "manage_subagents"
      ],
      "skills": [
        "plan-agents",
        "plan-hooks",
        "git-branch-lifecycle",
        "git-commit-stager",
        "git-safety-guard"
      ]
    },
    {
      "name": "retriever-agent",
      "definition": ".agents/agents/retriever-agent.md",
      "role": "Especialista em recuperacao documental, mapeamento de deltas e integridade referencial",
      "model": "flash",
      "permissions": {
        "read": [
          "utils/aulas/**",
          "utils/docs/**",
          "utils/memory/**",
          "pos_textuais/01_referencias.bib",
          "secoes/*.tex",
          "img/*.svg"
        ],
        "write": []
      },
      "tools_allowed": [
        "read_file",
        "search_web"
      ],
      "skills": [
        "bib-validator"
      ]
    },
    {
      "name": "latex-author-agent",
      "definition": ".agents/agents/latex-author-agent.md",
      "role": "Redator tecnico academico LaTeX e autor de diagramas SVG em coluna unica",
      "model": "pro",
      "permissions": {
        "read": [
          "00_config.tex",
          "main.tex",
          "utils/tema.md",
          "utils/memory/**",
          "pos_textuais/01_referencias.bib",
          "secoes/*.tex",
          "img/*",
          "out/preview_*.png"
        ],
        "write": [
          "secoes/*.tex",
          "img/*.svg",
          "img/*.pdf"
        ]
      },
      "tools_allowed": [
        "read_file",
        "write_file",
        "edit_file",
        "run_command"
      ],
      "skills": [
        "latex-writer",
        "refine-text",
        "svg-figure-pipeline"
      ]
    },
    {
      "name": "latex-compiler-agent",
      "definition": ".agents/agents/latex-compiler-agent.md",
      "role": "Verificador de compilacao deterministica, auditoria de logs e renderizacao seletiva",
      "model": "flash",
      "permissions": {
        "read": [
          "main.tex",
          "00_config.tex",
          "secoes/*.tex",
          "pos_textuais/*.bib",
          "img/*",
          "out/*"
        ],
        "write": [
          "out/*"
        ]
      },
      "tools_allowed": [
        "run_command",
        "read_file"
      ],
      "skills": [
        "latex-build",
        "bib-validator"
      ]
    },
    {
      "name": "technical-critic-agent",
      "definition": ".agents/agents/technical-critic-agent.md",
      "role": "Auditor adversarial de fisica, historiografia, estilo e layout visual em duas colunas",
      "model": "pro",
      "permissions": {
        "read": [
          "00_config.tex",
          "secoes/*.tex",
          "utils/tema.md",
          "utils/aulas/**",
          "utils/docs/**",
          "pos_textuais/01_referencias.bib",
          "utils/memory/**",
          "img/*",
          "out/main.log",
          "out/pages/*.png"
        ],
        "write": []
      },
      "tools_allowed": [
        "read_file",
        "search_web"
      ],
      "skills": [
        "academic-review",
        "bib-validator",
        "refine-text"
      ]
    }
  ],
  "pipeline_sequence": [
    "secoes/01_introducao.tex",
    "secoes/02_fundamentacao.tex",
    "secoes/03_metodologia.tex",
    "secoes/04_resultados.tex",
    "secoes/05_discussao.tex",
    "secoes/06_conclusao.tex",
    "secoes/00_resumo.tex"
  ]
}
